{
  "name": "unjam",
  "private": true,
  "version": "0.0.19",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "tsc --noEmit -p tsconfig.engine.json && tsc --noEmit && vitest run",
    "demo": "tsx src/engine/demo.ts",
    "levels": "sh tools/make-levels.sh",
    "release": "sh tools/release.sh",
    "check-live": "sh tools/check-live.sh",
    "gravity": "sh tools/make-gravity.sh",
    "safe": "tsx tools/safe-moves.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  }
}
